#!/usr/bin/env python3
"""Sample per-disk I/O utilization with iostat, append rows to a log file.

Set this to run in the background with cron. The util field is a percentage
(0-100). Only physical disks (sd*/nvme*) are recorded; loop/devicemapper
devices are ignored.
"""

import argparse
import datetime
import json
import os
import subprocess

# Remember to set up logrotate - this file grows unbounded.
DEFAULT_LOG_FILE = "/var/log/disk-utilization-stats.log"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Sample disk I/O utilization percentage with iostat."
    )
    parser.add_argument(
        "-f",
        "--log-file",
        default=os.environ.get("DISK_UTILIZATION_LOG", DEFAULT_LOG_FILE),
        help=f"Log file to append to (default: {DEFAULT_LOG_FILE})",
    )
    return parser.parse_args()


def is_actual_disk(device: str) -> bool:
    """iostat contains loop devices and dm-* mapper devices - skip those."""
    return device.startswith("sd") or device.startswith("nvme")


def sample_disk_utilization(now: float, iostat_json: str) -> str:
    """Turn an iostat -o JSON doc into a CSV line for one disk.

    Returns the first matching physical disk's row, or None if there are
    no physical disks in the sample.
    """
    parsed = json.loads(iostat_json)
    for dev in parsed["sysstat"]["hosts"][0]["statistics"][0]["disk"]:
        dev_name = dev["disk_device"]
        if is_actual_disk(dev_name):
            return f"{now},{dev_name},{dev['util']}"
    return None


def main() -> int:
    args = parse_args()
    result = subprocess.run(
        ["iostat", "-d", "-t", "-x", "-o", "JSON"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"iostat failed with exit code {result.returncode}: {result.stderr}")
        return result.returncode
    now = datetime.datetime.now().timestamp()
    row = sample_disk_utilization(now, result.stdout)
    if row is None:
        return 0
    print(row)
    with open(args.log_file, "a", encoding="utf-8") as f:
        f.write(f"{row}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())