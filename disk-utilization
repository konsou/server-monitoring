#!/usr/bin/env python3
import json
import subprocess

import _logging
import _discord

logger = _logging.configure_logger(log_file="/var/log/disk-utilization.log")


def main():
    result = subprocess.run(
        ["iostat", "-d", "-t", "-x", "-o", "JSON"],
        capture_output=True,
        text=True,
    )
    parsed = json.loads(result.stdout)

    device_utilization: list[tuple[str, str]] = []
    for dev in parsed["sysstat"]["hosts"][0]["statistics"][0]["disk"]:
        dev_name = dev["disk_device"]
        if is_actual_disk(dev_name):
            device_utilization.append((dev_name, f"{dev['util']} %"))
            # Easily parseable format for logs
            logger.info(f"{dev_name},{dev['util']}")

    # Human-readable format for discord msg
    aligned_table = align_table(device_utilization, headers=["disk", "utilization"])
    discord_msg = f"```\n{aligned_table}\n```"
    _discord.notify_discord(discord_msg)


def is_actual_disk(device: str) -> bool:
    """iostat contains loop devices, we don't care about those"""
    return device.startswith("sd") or device.startswith("nvme")


def align_table(data, headers=None) -> str:
    """
    Print data as an aligned table.

    Args:
        data: List of tuples/lists (e.g., [("sdg", "23.92"), ...])
        headers: Optional list of header names for the columns
    """
    if not data:
        return ""

    headers_and_data = []
    if headers:
        headers_and_data.append(headers)
    headers_and_data.extend(data)

    col_widths = [
        max(len(str(item)) for item in column) for column in zip(*headers_and_data)
    ]

    # Add padding
    col_widths = [w + 2 for w in col_widths]

    # Create format string: left-align first col, right-align others
    fmt_parts = []
    for i, width in enumerate(col_widths):
        if i == 0:
            fmt_parts.append(f"{{:<{width}}}")  # Left align device names
        else:
            fmt_parts.append(f"{{:>{width}}}")  # Right-align numbers

    fmt = " ".join(fmt_parts)

    output = []
    if headers:
        output.append(fmt.format(*headers))
        # Separator line
        output.append("-" * sum(col_widths) + "-" * (len(headers) - 1))

    for row in data:
        output.append(fmt.format(*row))
    return "\n".join(output)


if __name__ == "__main__":
    main()
